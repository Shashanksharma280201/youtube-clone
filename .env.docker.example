# Copy to .env.docker and fill in. docker-compose loads this for the app container.
# (WORKFLOW_TARGET_WORLD / WORKFLOW_POSTGRES_URL are set by docker-compose.yml.)

# --- App database (Neon Postgres) ---
DATABASE_URL=postgresql://user:pass@host-pooler.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://user:pass@host.neon.tech/neondb?sslmode=require

# --- Service auth (internal service) ---
# Key(s) external callers must send as: Authorization: Bearer <key>
# Comma-separated for rotation. Leave blank to keep the API open (dev only).
# Generate with: openssl rand -hex 32
SERVICE_API_KEY=

# --- Video storage ---
# The app uses Azure Blob Storage if AZURE_STORAGE_ACCOUNT / AZURE_STORAGE_KEY /
# AZURE_STORAGE_CONTAINER are all set; otherwise it falls back to AWS S3 below.
# Fill in ONE of the two blocks.

# Option A: AWS S3 (default)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Option B: Azure Blob Storage (set these three to use Azure instead of S3)
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_KEY=
# AZURE_STORAGE_CONTAINER=
# Optional: override the endpoint for sovereign clouds / Azurite
# AZURE_STORAGE_ENDPOINT=https://<account>.blob.core.windows.net

# --- AI (OpenAI does transcription + tagging + vision + guide) ---
OPENAI_API_KEY=
# Optional: model overrides (default gpt-4o / gpt-4o-mini; auto-falls back to 4o if unavailable)
# OPENAI_MODEL=gpt-4o
# OPENAI_MODEL_MINI=gpt-4o-mini

# --- Transcription pipeline ---
CHUNK_MINUTES=10
