generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  // "native" covers local dev + Vercel; the debian target is for the Docker
  // (bookworm / openssl 3.0.x) image so the query engine loads there too.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TranscriptStatus {
  NONE
  PENDING
  PROCESSING
  DONE
  FAILED
}

// Internal-service build: no users, likes, or comments. A video is a standalone
// record produced and consumed by the pipeline/API.
model Video {
  id                 String           @id @default(cuid())
  // ID supplied by the ingesting service. Our cuid stays the primary key.
  externalId         String?          @unique
  // Machine + tenant this video belongs to (from videoExtraction). Stored + echoed.
  machineId          String?
  tenantId           String?
  title              String
  description        String           @default("")
  blobUrl            String
  createdAt          DateTime         @default(now())
  views              Int              @default(0)
  transcriptStatus   TranscriptStatus @default(NONE)
  transcript         String?
  transcriptSegments Json?
  topicSegments      Json?
  // Denormalized first-chapter thumbnail for the home feed, so the grid query
  // never has to pull the heavy transcript/topicSegments JSON. Set in saveStep.
  thumbnailUrl       String?
  // Structured machine-maintenance guide (intro, preventive maintenance, error
  // codes, troubleshooting FAQs, safety, tools/parts, specs) — see DomainData.
  domainData         Json?
}
